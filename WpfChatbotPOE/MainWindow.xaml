<Window x:Class="WpfChatbotPOE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfChatbotPOE"
        mc:Ignorable="d"
        Title="Cyber Chat - Cybersecurity Assistant"
        Height="650"
        Width="900"
        MinHeight="500"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B172A">

    <Window.Resources>

        <!-- Main colour scheme -->
        <SolidColorBrush x:Key="DarkNavy" Color="#0B172A"/>
        <SolidColorBrush x:Key="CardBackground" Color="#14243A"/>
        <SolidColorBrush x:Key="Turquoise" Color="#00D4C8"/>
        <SolidColorBrush x:Key="LightText" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="MutedText" Color="#94A3B8"/>

        <!-- Send button style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00BFB3"/>
            <Setter Property="Foreground" Value="#071B2A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#4DE1D5"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <!-- Main application background -->
    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#081426" Offset="0"/>
                <GradientStop Color="#102B43" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <!-- Main layout -->
        <Grid Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="145"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="85"/>
            </Grid.RowDefinitions>


            <!-- ================= HEADER ================= -->

            <Border Grid.Row="0"
                    Background="#14243A"
                    CornerRadius="15"
                    Margin="0,0,0,15"
                    Padding="10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- Original image - unchanged -->
                    <Image HorizontalAlignment="Center"
                           Height="112"
                           Margin="0,10,0,0"
                           VerticalAlignment="Top"
                           Width="183"
                           Source="/cybersecurity_final.png"/>


                    <!-- Application title -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="10">

                        <TextBlock Text="CYBER CHAT"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#00D4C8"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Your Personal Cybersecurity Assistant"
                                   FontSize="11"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Right"
                                   Margin="0,5,0,0"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">

                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="#22C55E"
                                     Margin="0,0,6,0"/>

                            <TextBlock Text="Online and Ready"
                                       Foreground="#22C55E"
                                       FontSize="11"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= CHAT AREA ================= -->

            <Border Grid.Row="1"
                    Background="#14243A"
                    CornerRadius="15"
                    Padding="12"
                    Margin="0,0,0,15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Chat heading -->
                    <TextBlock Grid.Row="0"
                               Text="Conversation"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#00D4C8"
                               Margin="8,5,0,12"/>


                    <!-- Conversation area -->
                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="#0F1E32"
                                  Padding="8">

                        <StackPanel x:Name="ChatPanel"
                                    Orientation="Vertical"/>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- ================= INPUT AREA ================= -->

            <Border Grid.Row="2"
                    Background="#14243A"
                    CornerRadius="15"
                    Padding="10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>


                    <!-- Textbox container -->
                    <Border Grid.Column="0"
                            Background="#0F1E32"
                            CornerRadius="10"
                            BorderBrush="#31506A"
                            BorderThickness="1"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Height="45">

                        <TextBox x:Name="txtInput"
                                 Background="Transparent"
                                 Foreground="#F1F5F9"
                                 CaretBrush="#00D4C8"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Padding="12,8"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Type your message here..."
                                 KeyDown="txtInput_KeyDown"/>

                    </Border>


                    <!-- Send button -->
                    <Button x:Name="sendMessage"
                            Grid.Column="1"
                            Content="Send Message"
                            Height="45"
                            VerticalAlignment="Center"
                            Style="{StaticResource SendButtonStyle}"
                            Click="Button_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>

