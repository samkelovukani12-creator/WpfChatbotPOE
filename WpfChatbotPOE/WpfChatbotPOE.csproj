    <None Remove="User.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Windows.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="ChatBot.png" />
    <Resource Include="cybersecurity_final.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Startup.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
